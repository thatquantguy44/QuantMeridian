# ── Market Terminal — environment variables ───────────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
# Only MACRO_DB_URL is required for core market views to work.
# Everything else is optional — features degrade gracefully when absent.
#
# Source of truth: the fred-bronze-to-gold-pipeline writes macro_medallion
# (Postgres) locally, or a configured Postgres service for cloud deployments.
# ─────────────────────────────────────────────────────────────────────────────


# ── Gold DB (required) ────────────────────────────────────────────────────────

# Postgres (local Docker service from fred-bronze-to-gold-pipeline):
MACRO_DB_URL=postgresql://fred:fred@localhost:55432/macro_medallion

# Postgres (managed / cloud deploy):
# MACRO_DB_URL=postgres://user:password@host:5432/dbname

# SQLite (legacy local file, if needed):
# MACRO_DB_URL=sqlite:../fred-bronze-to-gold-pipeline/fred_local.db

# Warehouse Explorer production gate (leave disabled until the reviewed
# read-only role and restricted network path are in place):
# WAREHOUSE_EXPLORER_PRODUCTION_ENABLED=false
# WAREHOUSE_EXPLORER_READ_ONLY_ACK=false
# WAREHOUSE_EXPLORER_NETWORK_RESTRICTED_ACK=false
# WAREHOUSE_EXPLORER_QUERY_TIMEOUT_MS=5000
# WAREHOUSE_CURSOR_SECRET=<random-server-only-secret-required-in-production>

# Databricks Delta (set MACRO_DB_BACKEND=databricks and fill these):
# MACRO_DB_BACKEND=databricks
# DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>
# DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# MACRO_CATALOG=macro_prod   # default: macro_prod


# ── Market snapshot fallback ──────────────────────────────────────────────────

# Set to 1 to serve the committed build-time snapshots when the gold DB
# returns no rows for a market view (market, rates, regime, etc.).
# Off by default — prefer an explicit error over silently stale data.
# MARKET_SNAPSHOT_FALLBACK=0


# ── FRED live API (deprecated — optional for offline helpers only) ──────────

# FRED_API_KEY is no longer used by production routes (all read MACRO_DB_URL).
# Keep only if you run offline scripts like src/server/exportFredMaster.ts.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=


# ── News providers (optional — all four tried in order until one succeeds) ───

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Marketaux — https://www.marketaux.com/
# MARKETAUX_API_KEY=

# Finnhub — https://finnhub.io/
# FINNHUB_API_KEY=

# NewsAPI — https://newsapi.org/
# NEWSAPI_API_KEY=

# FinBERT NLP service (re-scores headlines; empty → keyword clustering only)
# NEWS_NLP_URL=http://localhost:8001


# ── Social sentiment (optional — Tier B live feeds) ────────────────────────

# StockTwits
# STOCKTWITS_ENABLED=1
# STOCKTWITS_ACCESS_TOKEN=

# Reddit (user-agent string, e.g. "MarketTerminal/1.0 by YourUsername")
# REDDIT_USER_AGENT=

# Note: AAII sentiment is now deterministic-only (Gold DB migration Phase 6).
# AAII_SENTIMENT_URL= (deprecated; no effect)


# ── Cron cache-warming (optional) ─────────────────────────────────────────────

# Secret passed in the Authorization header by the /api/cron/refresh route.
# Required if you deploy the cron warmer — set the same value in your scheduler.
# CRON_SECRET=
# CRON_TARGET_URL=https://your-deploy-url.onrender.com


# ── IBAL / InventoryBallast optimizer (optional) ──────────────────────────────

# Bearer token for the local services/inventory_optimizer_api FastAPI service.
# Must match INVENTORY_OPTIMIZER_API_TOKEN set on the service itself (see
# services/inventory_optimizer_api/README.md). Without this, /inventory-optimizer
# shows "IBAL service token is not configured" and every action fails.
# INVENTORY_OPTIMIZER_API_TOKEN=local-only-change-me

# Base URL of the running service. Default is http://127.0.0.1:8013 if unset.
# INVENTORY_OPTIMIZER_API_URL=http://127.0.0.1:8013

# Required in production only (NODE_ENV=production / VERCEL_ENV=production).
# Keep unset unless the operator has explicitly approved live IBAL access and
# the service is behind a trusted server-side boundary. Data Ops reports
# IBAL_PRODUCTION_DISABLED or IBAL_TRUSTED_BOUNDARY_MISSING when either is absent.
# IBAL_PRODUCTION_ENABLED=true
# IBAL_TRUSTED_ACCESS_BOUNDARY=<operator-approved-boundary-ref>


# ── AI features (optional) ────────────────────────────────────────────────────

# ANTHROPIC_API_KEY=


# ── Module agent workflows / LLM profiles (optional; spec009) ─────────────────
# Placeholders only. Nothing here is read by the browser (no VITE_ prefix). Settings files
# (settings/agent_workflows.json, settings/llm_profiles.json) reference these by NAME and never
# hold a key or URL themselves.

# Queue database. Required to use the panel; there is no fallback to MACRO_DB_URL.
#   local:  sqlite:./.data/agent_queue.db      deployed: a Postgres URL with write access
# AGENT_QUEUE_DB_URL=sqlite:./.data/agent_queue.db
# Server-only HMAC key for requester ids, and the bearer token shared only with the worker.
# AGENT_SESSION_SECRET=<random-32-bytes>
# AGENT_WORKER_TOKEN=<random-32-bytes>
# Deploy-level off switch (set to 1 to disable the panel and job creation).
# AGENT_WORKFLOWS_DISABLED=
# Production gate: all three are required in production (same model as IBAL above).
# AGENT_WORKFLOWS_PRODUCTION_ENABLED=true
# AGENT_WORKFLOWS_TRUSTED_ACCESS_BOUNDARY=<operator-approved-boundary-ref>
# AGENT_TRUSTED_IDENTITY_HEADER=<header-set-by-the-boundary>

# LLM profiles: pick the default, then set the variables for each profile you enable.
# LLM_PROFILE_DEFAULT=anthropic-direct
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OpenAI-compatible gateway (profile gateway-openai)
# LLM_GATEWAY_BASE_URL=
# LLM_GATEWAY_API_KEY=
# LLM_GATEWAY_MODEL=
# Anthropic-compatible gateway (profile gateway-anthropic)
# ANTHROPIC_GATEWAY_BASE_URL=
# ANTHROPIC_GATEWAY_API_KEY=
# ANTHROPIC_GATEWAY_MODEL=
# Local OpenAI-compatible server (profile local-openai)
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_MODEL=

# Worker only (runs on your machine, beside your QuantSmith checkout; QuantSmith is never
# fetched over the network).
# QUANTSMITH_ROOT=../QuantSmith
# QUANTSMITH_ASSETS_ROOT=
# QM_API_BASE_URL=http://localhost:5173
# QM_API_EXTRA_HEADERS_ENV=
# AGENT_WORKER_ID=
# AGENT_WORKER_CONCURRENCY=2


# ── Infrastructure (auto-set on Vercel / Render; only needed for self-host) ───

# PORT=3000
# HOST=0.0.0.0


# ── Deprecated — removed in Gold DB migration (Phase 4-6) ───────────────────

# These env vars are no longer used. Setting them has no effect.
# The Gold DB migration (Phase 4-6) unified all series/market data sources
# to read exclusively from MACRO_DB_URL. See docs/gold-db/GOLD_DB_MIGRATION_HANDOFF.md.
#
# FRED_API_KEY         ← Live FRED API (removed from production routes; kept for offline scripts only)
# MARKET_PIPELINE_URL  ← market_data_pipeline Flask API (removed Phase 4)
# MARKET_DB_URL        ← Yahoo/pipeline DuckDB (removed Phase 4)
# MARKET_DATA_DIR      ← pipeline Parquet output directory (removed Phase 4)
# MARKET_LENS_URL      ← market_lens_studio Flask API (removed Phase 4; now uses Gold DB)
# CHART_DB_URL         ← chart template Postgres (removed Phase 4; now uses MACRO_DB_URL)
# AAII_SENTIMENT_URL   ← AAII sentiment URL (removed Phase 6; now deterministic-only)
