{
  "_comment": "Defines QuantMeridian-Core: the QuantMeridian tree minus its securities-finance components. Built by scripts/downstream/build-core.mjs and synced by .github/workflows/sync-core.yml.",
  "downstream_repo": "thatquantguy44/QuantMeridian-Core",
  "excluded_modules": ["SLAB", "SQZ", "PB", "COLL", "CASH", "REINV", "LIQ", "SXU", "OPT", "IBAL", "DESK", "TASSIST", "UTIL"],
  "exclude": [
    "downstream/**",
    ".github/workflows/sync-core.yml",
    ".github/workflows/market-data-refresh.yml",
    "src/app/securities-lending/**",
    "src/app/prime-finance/**",
    "src/app/collateral/**",
    "src/app/cash-optimizer/**",
    "src/app/reinvestment/**",
    "src/app/liquidity/**",
    "src/app/sources-uses/**",
    "src/app/optimization/**",
    "src/app/inventory-optimizer/**",
    "src/app/trading-desk/**",
    "src/app/trading-assistant/**",
    "src/app/economics/utilization/**",
    "src/app/api/inventory-optimizer/**",
    "src/app/api/trading-assistant/**",
    "src/data/securitiesLending.ts",
    "src/data/squeeze.ts",
    "src/data/primeFinance.ts",
    "src/data/collateral.ts",
    "src/data/cash.ts",
    "src/data/reinvestment.ts",
    "src/data/liquidity.ts",
    "src/data/sourcesUses.ts",
    "src/data/optimization.ts",
    "src/data/etrading.ts",
    "src/data/trading.ts",
    "src/data/paperLedger.ts",
    "src/data/utilizationAnalytics.ts",
    "src/lib/inventoryOptimizer.ts",
    "src/lib/server/inventoryOptimizerProxy.ts",
    "src/lib/usePaperLedger.ts",
    "src/lib/usePaperLedger.test.ts",
    "src/lib/utilizationPdf.ts",
    "src/server/paperLedger.ts",
    "src/server/paperLedger.test.ts",
    "services/inventory_optimizer_api/**",
    "test/ibal.spec.ts",
    "src/lib/server/agent/deskDatasets.ts",
    "src/lib/server/agent/deskDatasets.test.ts",
    "contracts/agent/fixtures/results/example-secfin-carry.json",
    "docs/features/Agency Prime Electronic Trading Analytics Handoff.md",
    "docs/features/IBAL_*.md",
    "docs/features/SQUEEZE_RADAR_SPEC.md",
    "docs/features/completed/Feature Addition - Desk Pulse (Funding & Squeeze Radar).md",
    "docs/roadmaps/trading-bots-master.md",
    "docs/scenarios/IBAL_WHAT_IF_SCENARIOS.md"
  ],
  "leak_scan": {
    "_comment": "Strings that must not survive in the downstream source. Content words like 'collateral' are allowed in macro text; these are component identifiers: module codes, routes, and file names.",
    "paths": ["src", "settings", "contracts", "scripts", "test", "vite-plugins", "api", "services"],
    "patterns": [
      "\"(SLAB|SQZ|PB|COLL|CASH|REINV|LIQ|SXU|OPT|IBAL|DESK|TASSIST|UTIL)\"",
      "/securities-lending",
      "/prime-finance",
      "/collateral\\b",
      "/cash-optimizer",
      "/reinvestment",
      "/liquidity\\b",
      "/sources-uses",
      "/optimization\\b",
      "/inventory-optimizer",
      "/trading-desk",
      "/trading-assistant",
      "/economics/utilization",
      "data/securitiesLending",
      "data/squeeze",
      "inventoryOptimizerProxy",
      "secfin\\.carry",
      "sl_inventory|sl_loans|sl_borrow_demand"
    ],
    "allow": []
  }
}
