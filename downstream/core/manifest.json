{
  "_comment": "Defines QuantMeridian-Core: the QuantMeridian tree minus its securities-finance components. Built by scripts/downstream/build-core.mjs and synced by .github/workflows/sync-core.yml.",
  "downstream_repo": "thatquantguy44/QuantMeridian-Core",
  "excluded_modules": [
    "SLAB",
    "SQZ",
    "PB",
    "COLL",
    "CASH",
    "REINV",
    "LIQ",
    "SXU",
    "OPT",
    "IBAL",
    "DESK",
    "TASSIST",
    "UTIL",
    "SFE"
  ],
  "exclude": [
    "downstream/**",
    ".env",
    "screenshots/**",
    "docs/handoff.md",
    "docs/specs/spec009/**",
    "docs/specs/spec007/**",
    "docs/specs/spec005/**",
    "src/tests/downstreamSecretScan.test.ts",
    "scripts/downstream/**",
    ".tmp-verify-preview*.mjs",
    ".githooks/**",
    ".github/workflows/sync-core.yml",
    ".github/workflows/market-data-refresh.yml",
    "src/app/securities-lending/**",
    "src/app/prime-finance/**",
    "src/app/collateral/**",
    "src/app/cash-optimizer/**",
    "src/app/reinvestment/**",
    "src/app/liquidity/**",
    "src/app/sources-uses/**",
    "src/app/optimization/**",
    "src/app/inventory-optimizer/**",
    "src/app/trading-desk/**",
    "src/app/trading-assistant/**",
    "src/app/economics/utilization/**",
    "src/app/economics/sec-finance/**",
    "src/app/api/inventory-optimizer/**",
    "src/app/api/trading-assistant/**",
    "src/data/securitiesLending.ts",
    "src/data/squeeze.ts",
    "src/data/primeFinance.ts",
    "src/data/collateral.ts",
    "src/data/cash.ts",
    "src/data/reinvestment.ts",
    "src/data/liquidity.ts",
    "src/data/sourcesUses.ts",
    "src/data/optimization.ts",
    "src/data/etrading.ts",
    "src/data/trading.ts",
    "src/data/paperLedger.ts",
    "src/data/utilizationAnalytics.ts",
    "src/lib/inventoryOptimizer.ts",
    "src/lib/server/inventoryOptimizerProxy.ts",
    "src/lib/usePaperLedger.ts",
    "src/lib/usePaperLedger.test.ts",
    "src/lib/utilizationPdf.ts",
    "src/server/paperLedger.ts",
    "src/server/paperLedger.test.ts",
    "services/inventory_optimizer_api/**",
    "test/ibal.spec.ts",
    "src/lib/server/agent/deskDatasets.ts",
    "src/lib/server/agent/deskDatasets.test.ts",
    "docs/features/Agency Prime Electronic Trading Analytics Handoff.md",
    "docs/features/IBAL_*.md",
    "docs/features/SQUEEZE_RADAR_SPEC.md",
    "docs/features/completed/Feature Addition - Desk Pulse (Funding & Squeeze Radar).md",
    "docs/roadmaps/trading-bots-master.md",
    "docs/scenarios/IBAL_WHAT_IF_SCENARIOS.md"
  ],
  "leak_scan": {
    "_comment": "Component identifiers that must not survive in the downstream: registry entries by module code, routes, and imports of excluded files. Desk-lens wording inside macro pages (for example a desk playbook table) is content, not a component, and is not scanned.",
    "paths": [
      "src",
      "settings",
      "contracts",
      "scripts",
      "test",
      "vite-plugins",
      "api",
      "services"
    ],
    "patterns": [
      "(code|module): \"(SLAB|SQZ|PB|COLL|CASH|REINV|LIQ|SXU|OPT|IBAL|DESK|TASSIST|UTIL|SFE)\"",
      "on\\(\"(SLAB|SQZ|PB|COLL|CASH|REINV|LIQ|SXU|OPT|IBAL|DESK|TASSIST|UTIL|SFE)\"\\)",
      "/securities-lending",
      "/prime-finance",
      "/collateral\\b",
      "/cash-optimizer",
      "/reinvestment",
      "/liquidity\\b",
      "/sources-uses",
      "/optimization\\b",
      "/inventory-optimizer",
      "/trading-desk",
      "/trading-assistant",
      "/economics/utilization",
      "/economics/sec-finance",
      "data/securitiesLending",
      "data/squeeze",
      "data/primeFinance",
      "data/collateral",
      "data/cash\\b",
      "inventoryOptimizerProxy",
      "secfin\\.carry\\b(?!\")",
      "sl_inventory|sl_loans|sl_borrow_demand"
    ],
    "allow": [
      "src/app/api/agent/jobs/route.test.ts",
      "src/lib/server/agent/config.test.ts",
      "services/agent_worker/tests/test_settings.py"
    ],
    "allow_globs": [
      "contracts/agent/*.schema.json",
      "contracts/agent/fixtures/**",
      "contracts/agent/generated/**",
      "src/lib/agent/contracts/**",
      "services/agent_worker/src/agent_worker/contracts_generated/**",
      "src/lib/agent/contracts.test.ts",
      "services/agent_worker/tests/test_contracts.py"
    ]
  },
  "excluded_routes": [
    "/securities-lending",
    "/securities-lending/squeeze",
    "/prime-finance",
    "/collateral",
    "/cash-optimizer",
    "/reinvestment",
    "/liquidity",
    "/sources-uses",
    "/optimization",
    "/inventory-optimizer",
    "/trading-desk",
    "/trading-assistant",
    "/economics/utilization",
    "/economics/sec-finance"
  ],
  "secret_scan": {
    "_comment": "Hard-fail scan on the built tree (the downstream is public). allow_paths are test fixtures that deliberately contain fake key-shaped strings; allow_passwords are the throwaway local-development database passwords already used in docs and tests.",
    "allow_paths": [
      "contracts/agent/fixtures/settings/secret-shapes.json",
      "src/app/api/agent/profiles/profiles.route.test.ts",
      "src/lib/server/llm/client.test.ts",
      "src/lib/agent/secretShape.test.ts",
      "services/agent_worker/tests/**"
    ],
    "allow_passwords": [
      "fred",
      "pass",
      "password",
      "user",
      "secret",
      "changeme",
      "pw"
    ]
  },
  "scrub": [
    {
      "pattern": "/Users/[A-Za-z0-9._-]+/",
      "replacement": "/Users/<you>/",
      "comment": "local home paths in docs"
    }
  ]
}
