{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantmeridian.invalid/contracts/agent/job.schema.json",
  "title": "AgentJobCreateRequest",
  "description": "POST /api/agent/jobs body (agent-job/1). The workflow is always explicit. Structured `inputs` are the verifier's source for assumption claims.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-job/1"
    },
    "module": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,7}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F\\-]{8,64}$"
    },
    "workflow": {
      "type": "string",
      "enum": [
        "chart.build",
        "analysis.answer",
        "secfin.carry",
        "story.build",
        "brief.draft"
      ]
    },
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "macro_backdrop",
            "funding_conditions",
            "desk_review"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "inputs": {
      "anyOf": [
        {
          "$ref": "#/definitions/CarryInputs"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "$ref": "#/definitions/ContextSnapshot"
    },
    "profile": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9\\-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_job_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9\\-]{8,64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow": {
            "const": "secfin.carry"
          }
        },
        "required": [
          "workflow"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "inputs"
            ],
            "properties": {
              "inputs": {
                "type": "object"
              }
            }
          },
          {
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  ],
  "required": [
    "schema_version",
    "module",
    "thread_id",
    "workflow",
    "context"
  ],
  "definitions": {
    "SeriesRef": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "econ",
            "fred",
            "market",
            "lens"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.\\-^=]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "id"
      ]
    },
    "ContextSnapshot": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SeriesRef"
          },
          "maxItems": 8
        },
        "range": {
          "type": "string",
          "enum": [
            "1M",
            "3M",
            "6M",
            "1Y",
            "2Y",
            "5Y",
            "MAX"
          ]
        },
        "transform": {
          "type": "string",
          "enum": [
            "none",
            "index100",
            "pct_change",
            "yoy",
            "mom",
            "zscore",
            "log"
          ]
        },
        "chartType": {
          "type": "string",
          "enum": [
            "line",
            "area"
          ]
        },
        "asOfDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "tenors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,2}(M|Y)$"
          },
          "maxItems": 16
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\-]{1,48}$"
          },
          "maxItems": 16
        },
        "metric": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.\\-]{1,48}$"
        }
      },
      "additionalProperties": false
    },
    "CarryInputs": {
      "type": "object",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "long",
            "short"
          ]
        },
        "notional": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000000000.0
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "tenor": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(D|W|M|Y)$"
        },
        "benchmark": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.\\-]{1,48}$"
        },
        "spread_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "borrow_fee_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "use_desk_borrow_fee": {
          "type": "boolean"
        },
        "rebate_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "margin_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "shocks_bps": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -500,
            "maximum": 500
          },
          "maxItems": 5
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "end"
          ]
        },
        {
          "required": [
            "tenor"
          ]
        }
      ],
      "required": [
        "side",
        "notional",
        "start",
        "benchmark"
      ]
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "verifying",
        "succeeded",
        "needs_clarification",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "AGENT_DISABLED",
        "AGENT_PRODUCTION_DISABLED",
        "AGENT_TRUSTED_BOUNDARY_MISSING",
        "AGENT_QUEUE_NOT_CONFIGURED",
        "AGENT_MODULE_DISABLED",
        "AGENT_CONTEXT_INVALID",
        "AGENT_INPUTS_INVALID",
        "AGENT_QUEUE_LIMIT",
        "AGENT_IDEMPOTENCY_CONFLICT",
        "WORKFLOW_UNKNOWN",
        "WORKFLOW_NOT_READY",
        "LLM_PROFILE_UNKNOWN",
        "LLM_PROFILE_NOT_ALLOWED",
        "LLM_PROFILE_UNAVAILABLE",
        "DATA_CLASS_NOT_APPROVED",
        "AGENT_WORKER_UNAUTHORIZED",
        "LLM_BUDGET_EXCEEDED",
        "LLM_PROVIDER_ERROR",
        "LLM_OUTPUT_INVALID",
        "JOB_TIMEOUT",
        "WORKER_LOST",
        "QUEUE_TTL_EXPIRED",
        "DATA_UNAVAILABLE",
        "UNSUPPORTED_CHART",
        "UNSUPPORTED_METRIC",
        "RESULT_SCHEMA_INCOMPATIBLE",
        "VERIFICATION_ERROR"
      ]
    }
  }
}
