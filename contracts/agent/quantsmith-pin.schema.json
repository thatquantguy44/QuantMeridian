{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantmeridian.invalid/contracts/agent/quantsmith-pin.schema.json",
  "title": "QuantSmithPin",
  "description": "contracts/agent/quantsmith-pin.json: reviewed content fingerprints of the locally supplied QuantSmith copy (quantsmith-pin/1).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "quantsmith-pin/1"
    },
    "package": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "quantsmith"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "code_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "code_digest"
      ]
    },
    "assets": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./\\-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "digest",
        "paths"
      ]
    },
    "reviewed": {
      "type": "object",
      "properties": {
        "on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "on",
        "source_commit"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "assets",
    "reviewed"
  ]
}
