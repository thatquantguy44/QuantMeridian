{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantmeridian:indemnification:rating-pd-table:1.0",
  "title": "Rating to 1-year default probability table 1.0 (spec020 decision 2, IND-018)",
  "description": "Illustrative annual default probability per rating. Non-decreasing in credit quality from AAA to CCC (checked by snapshotIssues and the service); NR is unrated and sits outside that order. A user-entered credit spread overrides the table for a borrower.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table_version",
    "label",
    "pd_1y"
  ],
  "properties": {
    "table_version": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "enum": [
        "ILLUSTRATIVE",
        "USER_INPUT"
      ]
    },
    "pd_1y": {
      "type": "object",
      "additionalProperties": false,
