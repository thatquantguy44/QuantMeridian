{
  "name": "market-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quant Intelligence Platform — a Bloomberg-style operating system for market intelligence, macro analytics, securities finance, treasury analytics, and AI decision support.",
  "scripts": {
    "dev": "vite",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/server/index.ts --outDir dist-server",
    "build:handler": "vite build --ssr src/server/handler.ts --outDir dist-vercel",
    "build:vercel": "npm run build:client && npm run build:handler",
    "export:econ-snapshot": "vite build --ssr src/server/exportEconSnapshot.ts --outDir dist-tools && node dist-tools/exportEconSnapshot.js",
    "refresh:fred-master": "vite build --ssr src/server/exportFredMaster.ts --outDir dist-tools && node dist-tools/exportFredMaster.js",
    "refresh:aaii-sentiment": "vite build --ssr src/server/exportAaiiSentiment.ts --outDir dist-tools && node dist-tools/exportAaiiSentiment.js",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check:gold-policy": "bash scripts/check-gold-db-policy.sh",
    "check:quantsmith-pin": "bash scripts/check-quantsmith-pin.sh",
    "check:agent-skills-pin": "node scripts/check-agent-skills-pin.mjs",
    "export:agent-metric-registry": "vite build --ssr scripts/export-agent-metric-registry.ts --outDir dist-tools && node dist-tools/export-agent-metric-registry.js",
    "check:agent-metric-registry": "vite build --ssr scripts/export-agent-metric-registry.ts --outDir dist-tools && node dist-tools/export-agent-metric-registry.js --check",
    "generate:agent-contracts": "node scripts/generate-agent-contracts.mjs",
    "check:agent-contracts": "node scripts/generate-agent-contracts.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:fred-gold": "python3 scripts/publish_fred_gold_to_postgres.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.69.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "^12.11.1",
    "clsx": "2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "0.16.11",
    "lucide-react": "0.456.0",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "undici": "8.5.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/katex": "0.16.7",
    "@types/node": "20.16.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
